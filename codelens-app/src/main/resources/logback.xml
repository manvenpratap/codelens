<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Console appender with timestamp + logger name -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%-15thread] %highlight(%-5level) %cyan(%logger{30}) - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Rolling Application Log File -->
  <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>./codelens-data/logs/codelens.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>./codelens-data/logs/codelens.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>25MB</maxFileSize>
      <maxHistory>14</maxHistory>
      <totalSizeCap>150MB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%-18thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Dedicated Diagnostic Error & Warning Log (crashes, leaks, heap warnings, SQL errors) -->
  <appender name="DIAGNOSTIC_ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>./codelens-data/logs/codelens-diagnostics-warn-error.log</file>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>WARN</level>
    </filter>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>./codelens-data/logs/codelens-diagnostics-warn-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>20MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>100MB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%-18thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Suppress noisy Javalin / Jetty startup logs; keep INFO for CodeLens itself -->
  <logger name="io.javalin"              level="WARN"/>
  <logger name="org.eclipse.jetty"       level="WARN"/>
  <logger name="org.apache.lucene"       level="WARN"/>
  <logger name="com.zaxxer.hikari"       level="WARN"/>
  <logger name="com.codelens"            level="INFO"/>

  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="APP_FILE"/>
    <appender-ref ref="DIAGNOSTIC_ERROR_FILE"/>
  </root>
</configuration>
